# Variables d'environnement (copier en .env.local puis dans Vercel)

# --- Supabase (optionnel : la synchro cloud reste désactivée si absents) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stripe (serverless uniquement, côté serveur) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://snowball-pro.vercel.app/?pro=success
STRIPE_CANCEL_URL=https://snowball-pro.vercel.app/?pro=cancel
